# ---------------------------------------------------------------------------
# Jireh backend — copy to backend/.env and fill in. NEVER commit the real file.
# Every value below is validated at boot (backend/src/env.ts); production
# refuses to start with an unsafe combination.
# ---------------------------------------------------------------------------

# ---- runtime --------------------------------------------------------------
NODE_ENV=development
PORT=4000
# debug | info | warn | error | silent  (logs are always redacted)
LOG_LEVEL=info

# ---- database -------------------------------------------------------------
# Neon: use the pooled (-pooler) host here and the direct host in DIRECT_URL.
# Self-hosted: a single DATABASE_URL is enough. Keep sslmode=require off-localhost.
DATABASE_URL=postgresql://jireh:change-me@localhost:5432/jireh
# DIRECT_URL=postgresql://jireh:change-me@localhost:5432/jireh

# Bounded pool + query timeouts.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
# auto = honour sslmode in the URL | require = force TLS | disable = plaintext (dev only)
DB_SSL=auto
# Never set false in production (the boot check rejects it).
DB_SSL_VERIFY=true

# ---- email ----------------------------------------------------------------
# TLS is mandatory: credentials are never sent over a plaintext session.
# SMTP_SECURE and SMTP_PORT must be paired correctly in EVERY environment:
#   587 (STARTTLS, requireTLS) + SMTP_SECURE=false   <- default, Gmail
#   465 (implicit TLS)         + SMTP_SECURE=true
# A mismatch, a host with spaces/credentials, or a FROM address with control
# characters makes the API refuse to boot. Certificates are always verified
# (TLS >= 1.2); do not weaken this to accept a self-signed SMTP certificate.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-google-app-password
# SMTP_FROM="Jireh Healthcare Solutions <no-reply@your-domain>"
# Required explicitly in production (no default there).
# ADMIN_EMAIL=info@jirehhealthcaresolutions.com

# ---- http surface ---------------------------------------------------------
# Comma-separated origins, scheme + host only (no path, no trailing slash, no "*").
# Production requires https and rejects localhost.
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of the API (nginx/Caddy = 1). Leave 0 otherwise.
TRUST_PROXY=0
MAX_BODY_KB=20
REQUEST_TIMEOUT_MS=15000
# Submissions faster than this (ms) are treated as bots. 0 disables the timing trap.
HONEYPOT_MIN_MS=700
