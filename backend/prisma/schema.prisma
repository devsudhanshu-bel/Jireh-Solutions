generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Enquiry {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contact     String
  email       String
  profession  String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("enquiries")
}

model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  contact   String
  email     String
  address   String   @default("")
  service   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}
